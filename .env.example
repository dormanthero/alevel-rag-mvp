# ========== A-level RAG MVP 环境变量 ==========
# 复制本文件为 .env 后填写（.env 已被 gitignore，勿提交密钥）
# 默认不填也能跑：embedding 本地 + 回答用检索模板

# 回答模式：auto（有密钥就调 LLM，否则模板）| llm（强制 LLM）| template（强制模板）
# 也可在命令行用 --mode 覆盖
LLM_MODE=auto

# --- OpenAI 或任意 OpenAI 兼容网关 ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- 本地 Ollama（无需 OPENAI_API_KEY）---
# 设置后 ask.py 会用 {OLLAMA_HOST}/v1 + 伪密钥 ollama
# 请先：ollama pull qwen2.5:7b
# OLLAMA_HOST=http://127.0.0.1:11434
# OPENAI_MODEL=qwen2.5:7b
